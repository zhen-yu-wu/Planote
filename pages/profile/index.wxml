<view class="page-shell profile-shell">
  <view class="brand-card card">
    <view class="brand-mark"><view class="mark-accent"></view><text>序</text></view>
    <view><view class="brand-name">我的日序</view><view class="brand-sub">把注意力留给重要的事</view></view>
  </view>

  <view class="stats-card card">
    <view class="stat"><text class="stat-value">{{active}}</text><text class="stat-label">进行中</text></view>
    <view class="stat"><text class="stat-value">{{completed}}</text><text class="stat-label">已完成</text></view>
    <view class="stat"><text class="stat-value">{{total}}</text><text class="stat-label">全部记录</text></view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">同步与备份</text></view>
    <view wx:if="{{syncError}}" class="sync-warning">同步未完成：{{syncError}}。本机记录仍保留，请检查后重试。</view>
    <view wx:if="{{restorePaused}}" class="sync-warning">为保护本机操作结果，自动同步已暂停。重新同步前请确认云端合并提示。</view>
    <view class="card menu-card">
      <view class="menu-row access-row" bindtap="openSyncAuth"><view><view>同步权限</view><view class="menu-sub">验证后绑定当前微信账号，有效期以授权说明为准</view></view><view class="cloud-status {{accessStatusClass}}">{{accessStatus}}</view></view>
      <view class="menu-row" bindtap="openNotifications"><view><view>每日通知</view><view class="menu-sub">设置提醒时间与今日、本周、滞留内容</view></view><text>›</text></view>
      <view wx:if="{{syncRole === 'admin'}}" class="menu-row" bindtap="openKeyManager"><view><view>分发密钥管理</view><view class="menu-sub">创建、查看有效期或收回同步密钥</view></view><text>›</text></view>
      <view class="menu-row sync-row"><view><view>自动同步</view><view class="menu-sub">{{syncAuthorized ? '修改事项或打开主要页面时自动同步' : '获得同步权限后可以开启'}}</view></view><switch checked="{{autoSync && syncAuthorized}}" disabled="{{!syncAuthorized}}" color="#397356" bindchange="setAutoSync" /></view>
      <view class="menu-row" bindtap="syncNow"><view><view>立即同步</view><view class="menu-sub">{{syncAuthorized ? lastSyncText + ' · 手动检查所有变更' : '验证同步权限后使用'}}</view></view><view class="cloud-status {{syncStatusClass}}">{{syncAuthorized ? syncStatus : '待验证'}}</view></view>
      <view class="menu-row" bindtap="exportData"><view><view>导出备份</view><view class="menu-sub">将本地数据复制为 JSON</view></view><text>›</text></view>
      <view class="menu-row" bindtap="importData"><view><view>导入备份</view><view class="menu-sub">粘贴 JSON 内容并确认导入</view></view><text>›</text></view>
      <view wx:if="{{hasRecovery}}" class="menu-row" bindtap="restoreBackup"><view><view>恢复操作前的快照</view><view class="menu-sub">恢复本机并暂停同步</view></view><text>›</text></view>
      <view class="menu-row danger" bindtap="clearData"><view><view>清空本机已知事项</view><view class="menu-sub">开启同步时删除云端对应记录</view></view><text>›</text></view>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">关于维护</text></view>
    <view class="support-entry card" bindtap="openSupport">
      <view class="support-entry-copy">
        <view class="support-entry-title">捐赠与反馈</view>
        <view class="support-entry-sub">关于维护，也留一个联系我的方式</view>
      </view>
      <text class="support-entry-arrow">›</text>
    </view>
  </view>

  <view class="section">
    <view class="card menu-card"><view class="menu-row" bindtap="showAbout"><view>关于我的日序</view><text>›</text></view></view>
  </view>
  <view class="card menu-card"><view class="menu-row" bindtap="openPrivacy"><view>隐私与数据管理</view><text>›</text></view></view>
  <view class="local-note">未授权账号仅使用本地存储</view>

  <view wx:if="{{showSupport}}" class="support-overlay" bindtap="closeSupport" catchtouchmove="preventSupportMove">
    <view class="support-dialog" catchtap="keepSupportOpen">
      <view class="support-header">
        <view class="support-dialog-title">想和你说几句</view>
        <button class="support-close" bindtap="closeSupport" aria-label="关闭">×</button>
      </view>
      <scroll-view class="support-scroll" scroll-y>
        <view class="support-letter">
          <view class="support-paragraph">我的日序是我独立开发、维护的小工具。谢谢你愿意用它记录自己的事情。</view>
          <view class="support-paragraph">第一年的云资源费用由我承担。云同步和通知会有持续的开支，如果这个小工具帮到了你，也欢迎捐赠一点维护费用。金额随意，我会把它用在云服务和日常维护上。</view>
          <view class="support-paragraph">捐赠任意金额，我都会赠送云同步资格。捐赠后联系我，我会发给你同步密钥。在云同步服务正常运营期间，你可以持续使用。本地记录不用捐赠也能正常使用。</view>
          <view class="support-paragraph">我会尽量让它保持简单、干净，日常使用不会自动弹出或插入广告。你可以自主选择是否通过广告入口支持维护，我也不会出售你的数据。</view>
          <view class="support-paragraph">有件事也想提前说清楚：如果长期无法承担开支，我可能会停止云同步，甚至下架小程序。到时我会尽可能提前通知，留出时间让你导出、备份自己的记录。</view>
          <view class="support-thanks">谢谢你读到这里。</view>
          <view class="support-signature">我的日序的开发者</view>
          <view class="support-contact">
            <view class="support-contact-title">联系我</view>
            <view class="support-contact-copy">想捐赠，可以通过下面的二维码加我微信。遇到 bug，或有什么建议，也可以在这里告诉我。</view>
            <image class="support-qr" src="{{supportQrImage}}" mode="widthFix" show-menu-by-longpress="{{true}}" bindtap="previewSupportQr" aria-label="开发者的微信二维码，点击查看大图" />
            <view class="support-qr-hint">点开查看大图，可保存后在微信扫一扫中选择相册</view>
          </view>
        </view>
      </scroll-view>
      <view class="support-footer">
        <button class="support-primary" bindtap="closeSupport">知道了，继续使用</button>
        <view wx:if="{{supportFirstView}}" class="support-footnote">这段说明只会自动弹出这一次</view>
      </view>
    </view>
  </view>
</view>
