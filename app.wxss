page {
  min-height: 100%;
  background: #f6f7f2;
  color: #20251f;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

button { font: inherit; }

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx 180rpx;
}

.card {
  background: #fff;
  border: 1rpx solid rgba(32, 37, 31, .06);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 34rpx rgba(40, 54, 44, .055);
}

.section { margin-top: 30rpx; }
.section { animation: section-rise-in .44s cubic-bezier(.2, .72, .25, 1) both; }
.section:nth-child(2) { animation-delay: .04s; }
.section:nth-child(3) { animation-delay: .08s; }
.section:nth-child(4) { animation-delay: .12s; }
.section:nth-child(5) { animation-delay: .16s; }
.section:nth-child(6) { animation-delay: .2s; }
.section:nth-child(7) { animation-delay: .24s; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 0 4rpx 16rpx; }
.section-title { font-size: 32rpx; font-weight: 700; letter-spacing: .5rpx; }
.section-meta, .muted { color: #92988f; font-size: 24rpx; }

.empty { padding: 44rpx 24rpx; text-align: center; color: #a3a89f; }

.fab {
  position: fixed;
  z-index: 20;
  right: 30rpx;
  bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #2f6b4f;
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  box-shadow: 0 12rpx 28rpx rgba(47, 107, 79, .28);
  animation: fab-pop-in .34s cubic-bezier(.2, .9, .28, 1.25) both;
}
.fab:active { transform: scale(.94); background: #285f46; }

.task-row { display: flex; align-items: flex-start; padding: 24rpx 22rpx; }
.task-row + .task-row { border-top: 1rpx solid #eff1ec; }
.check {
  flex: 0 0 auto;
  width: 38rpx;
  height: 38rpx;
  margin: 3rpx 20rpx 0 0;
  border: 3rpx solid #b9beb5;
  border-radius: 50%;
  color: transparent;
  font-size: 23rpx;
  line-height: 34rpx;
  text-align: center;
}
.check.done { border-color: #7aa18c; background: #7aa18c; color: #fff; }
.check:active { transform: scale(.82); }
.task-main { min-width: 0; flex: 1; }
.task-title { font-size: 29rpx; line-height: 1.4; }
.task-title.done { color: #a8ada5; text-decoration: line-through; }
.task-sub { margin-top: 7rpx; color: #8d938a; font-size: 23rpx; }
.more { padding: 0 4rpx 12rpx 20rpx; color: #a0a59d; font-size: 34rpx; line-height: 30rpx; }

.pill { display: inline-flex; padding: 6rpx 14rpx; border-radius: 999rpx; font-size: 21rpx; }
.pill-red { background: #fff0ec; color: #c14e38; }
.pill-orange { background: #fff4e4; color: #b46c1e; }
.pill-green { background: #eaf4ed; color: #387354; }
.pill-gray { background: #eff1ed; color: #747b71; }

.task-row:active, .schedule-row:active, .focus-row:active,
.inbox-row:active, .calendar-item:active, .goal-row:active, .menu-row:active {
  background: rgba(47, 107, 79, .045);
}

.finishing { pointer-events: none; animation: task-finish-out .26s .18s ease-in forwards; }
.finishing .check, .finishing .focus-check { border-color: #6f9b82; background: #6f9b82; color: #fff; animation: check-confirm .22s cubic-bezier(.2, .8, .25, 1.25) both; }

@keyframes section-rise-in {
  from { opacity: .01; transform: translateY(22rpx) scale(.985); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fab-pop-in {
  from { opacity: 0; transform: scale(.72) rotate(-12deg); }
  to { opacity: 1; transform: scale(1) rotate(0); }
}

@keyframes task-finish-out {
  from { opacity: 1; transform: translateX(0); }
  to { opacity: 0; transform: translateX(32rpx); }
}

@keyframes check-confirm {
  0% { transform: scale(.72); }
  65% { transform: scale(1.16); }
  100% { transform: scale(1); }
}
