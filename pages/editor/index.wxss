.editor-shell { padding: 24rpx 28rpx 100rpx; }
.segmented { display: flex; padding: 7rpx; border-radius: 20rpx; background: #e9ece6; }
.segment { flex: 1; padding: 15rpx 8rpx; border-radius: 15rpx; color: #81877e; text-align: center; font-size: 25rpx; }
.segment.active { background: #fff; color: #285f46; font-weight: 650; box-shadow: 0 4rpx 14rpx rgba(44, 65, 51, .08); }
.type-tabs { margin-bottom: 24rpx; }
.scope-tabs { margin-bottom: 24rpx; }
.form-card { margin-bottom: 24rpx; overflow: hidden; border: 1rpx solid rgba(32, 37, 31, .06); border-radius: 24rpx; background: #fff; }
.title-input { height: 100rpx; padding: 0 26rpx; font-size: 34rpx; font-weight: 650; }
.content-input { box-sizing: border-box; width: 100%; min-height: 160rpx; padding: 24rpx 26rpx 34rpx; border-top: 1rpx solid #eff1ec; color: #596057; font-size: 28rpx; line-height: 1.55; }
.field-label { margin: 34rpx 8rpx 14rpx; color: #777e75; font-size: 24rpx; }
.field-row, .priority-row { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; padding: 0 24rpx; }
.field-row + .field-row, .priority-row + .priority-row, picker + picker, picker + .field-row { border-top: 1rpx solid #eff1ec; }
.field-value { color: #397356; font-size: 26rpx; }
.field-value.plain { color: #858b82; font-size: 23rpx; }
.level-group { display: flex; gap: 10rpx; }
.level { min-width: 64rpx; padding: 10rpx 4rpx; border-radius: 12rpx; background: #f0f2ee; color: #92978f; text-align: center; font-size: 23rpx; }
.level.selected { font-weight: 650; }
.level-1 { background: #e8f2eb; color: #47765c; }
.level-2 { background: #fff1dc; color: #a96822; }
.level-3 { background: #ffebe6; color: #b94e39; }
.progress-field { padding: 24rpx 18rpx 16rpx 24rpx; border-top: 1rpx solid #eff1ec; }
.year-range-row { display: flex; align-items: center; min-height: 112rpx; padding: 0 20rpx; border-top: 1rpx solid #eff1ec; }
.range-picker { min-width: 0; flex: 1; }
.range-cell { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 17rpx 4rpx; border-radius: 16rpx; background: #f5f7f3; }
.range-label { color: #90968d; font-size: 20rpx; }
.range-value { margin-top: 6rpx; color: #397356; font-size: 23rpx; font-weight: 600; }
.range-arrow { margin: 0 14rpx; color: #a2a89f; font-size: 26rpx; }
.progress-label { display: flex; justify-content: space-between; padding-right: 8rpx; }
.progress-label text:last-child { color: #397356; }
.save-button { width: 420rpx; margin: 52rpx auto 0; border-radius: 44rpx; background: #2f6b4f; color: white; font-size: 28rpx; font-weight: 650; line-height: 88rpx; box-shadow: 0 12rpx 28rpx rgba(47, 107, 79, .24); }
.save-button::after, .delete-button::after { border: 0; }
.delete-button { margin-top: 20rpx; background: transparent; color: #bd5a47; font-size: 27rpx; }
