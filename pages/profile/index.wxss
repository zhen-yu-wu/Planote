.profile-shell { padding-top: 36rpx; }
.brand-card { display: flex; align-items: center; padding: 32rpx; }
.brand-mark { position: relative; display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; margin-right: 22rpx; overflow: hidden; border: 1rpx solid #cedfd3; border-radius: 24rpx; background: linear-gradient(145deg, #edf6ef, #dcebe1); color: #2f6b4f; font-size: 36rpx; font-weight: 700; box-shadow: 0 7rpx 18rpx rgba(47, 107, 79, .1); }
.brand-mark text { position: relative; z-index: 1; }
.mark-accent { position: absolute; top: -18rpx; right: -14rpx; width: 50rpx; height: 50rpx; border-radius: 50%; background: rgba(75, 137, 99, .14); }
.brand-name { font-size: 37rpx; font-weight: 750; letter-spacing: .5rpx; }
.brand-sub { margin-top: 6rpx; color: #8a9187; font-size: 23rpx; }
.stats-card { display: flex; margin-top: 24rpx; padding: 28rpx 6rpx; }
.stat { position: relative; display: flex; flex: 1; flex-direction: column; align-items: center; }
.stat + .stat::before { position: absolute; top: 5rpx; bottom: 5rpx; left: 0; width: 1rpx; background: #eceee9; content: ''; }
.stat-value { font-size: 38rpx; font-weight: 700; }
.stat-label { margin-top: 6rpx; color: #92988f; font-size: 22rpx; }
.menu-card { overflow: hidden; }
.menu-row { display: flex; align-items: center; justify-content: space-between; min-height: 100rpx; padding: 0 24rpx; }
.menu-row + .menu-row { border-top: 1rpx solid #eff1ec; }
.menu-row > text { color: #abb0a8; font-size: 39rpx; }
.menu-sub { margin-top: 6rpx; color: #9a9f97; font-size: 21rpx; }
.menu-row.danger { color: #b95342; }
.sync-row { background: linear-gradient(90deg, rgba(235, 244, 237, .7), rgba(255, 255, 255, 0)); }
.sync-row switch { transform: scale(.84); transform-origin: right center; }
.cloud-status { padding: 7rpx 13rpx; border-radius: 999rpx; background: #eff1ed; color: #80877e; font-size: 20rpx; }
.cloud-status.checking { background: #fff2df; color: #a36c2d; }
.cloud-status.connected { background: #e5f1e8; color: #347152; }
.cloud-status.failed { background: #ffebe6; color: #b64f3c; }
.cloud-status.locked { background: #f1eeea; color: #8b7d70; }
.access-row { background: linear-gradient(90deg, rgba(246, 241, 231, .72), rgba(255, 255, 255, 0)); }
.local-note { margin-top: 48rpx; color: #a5aaa2; text-align: center; font-size: 22rpx; }
.support-entry { position: relative; display: flex; align-items: center; min-height: 118rpx; overflow: hidden; padding: 0 24rpx; border: 1rpx solid rgba(126, 103, 56, .12); border-radius: 28rpx; background: linear-gradient(135deg, #fffdf7 0%, #f3f7ec 100%); box-shadow: 0 12rpx 34rpx rgba(72, 79, 54, .06); }
.support-entry::after { position: absolute; top: -56rpx; right: -30rpx; width: 180rpx; height: 180rpx; border-radius: 50%; background: rgba(199, 177, 114, .1); content: ''; }
.support-entry:active { transform: scale(.992); }
.support-entry-mark { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 70rpx; height: 70rpx; margin-right: 20rpx; border-radius: 22rpx; background: linear-gradient(145deg, #527c62, #315f48); color: #fffdf6; font-family: serif; font-size: 29rpx; box-shadow: 0 9rpx 20rpx rgba(49, 95, 72, .18); }
.support-entry-copy { position: relative; z-index: 1; min-width: 0; flex: 1; }
.support-entry-title { color: #304c3b; font-size: 28rpx; font-weight: 700; }
.support-entry-sub { margin-top: 7rpx; overflow: hidden; color: #879084; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.support-entry-action { position: relative; z-index: 1; flex: 0 0 auto; margin-left: 14rpx; color: #6e7e70; font-size: 21rpx; }
.support-entry-action text { margin-left: 5rpx; font-size: 31rpx; }
.support-overlay { position: fixed; z-index: 100; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 34rpx; background: rgba(25, 32, 27, .48); backdrop-filter: blur(10rpx); animation: support-fade-in .24s ease-out both; }
.support-dialog { position: relative; box-sizing: border-box; width: 100%; max-height: 86vh; overflow: hidden; border: 1rpx solid rgba(255, 255, 255, .75); border-radius: 36rpx; background: #fffefa; box-shadow: 0 32rpx 90rpx rgba(20, 34, 25, .28); animation: support-dialog-in .34s cubic-bezier(.2, .85, .26, 1.08) both; }
.support-scroll { box-sizing: border-box; max-height: 86vh; padding: 46rpx 38rpx 36rpx; }
.support-glow { position: absolute; border-radius: 50%; pointer-events: none; }
.glow-one { top: -110rpx; right: -90rpx; width: 300rpx; height: 300rpx; background: rgba(202, 183, 121, .13); }
.glow-two { top: 210rpx; left: -150rpx; width: 260rpx; height: 260rpx; background: rgba(89, 137, 105, .08); }
.support-close { position: absolute; z-index: 3; top: 20rpx; right: 20rpx; width: 58rpx; height: 58rpx; margin: 0; padding: 0; border-radius: 50%; background: rgba(255, 255, 255, .76); color: #8b9189; font-size: 38rpx; font-weight: 300; line-height: 54rpx; }
.support-close::after, .support-primary::after { border: 0; }
.support-kicker { color: #9b7d43; font-size: 18rpx; font-weight: 700; letter-spacing: 4rpx; }
.support-dialog-title { margin-top: 16rpx; color: #244533; font-family: serif; font-size: 44rpx; font-weight: 700; line-height: 1.28; letter-spacing: 1rpx; }
.support-lead { margin-top: 20rpx; color: #737c72; font-size: 23rpx; line-height: 1.7; }
.support-promise { margin-top: 26rpx; padding: 22rpx 24rpx; border: 1rpx solid #e8eee5; border-radius: 24rpx; background: rgba(246, 249, 243, .86); }
.promise-item { display: flex; align-items: center; color: #4e5c51; font-size: 22rpx; line-height: 1.55; }
.promise-item + .promise-item { margin-top: 12rpx; }
.promise-dot { flex: 0 0 auto; width: 11rpx; height: 11rpx; margin-right: 15rpx; border-radius: 50%; background: #6e997f; box-shadow: 0 0 0 6rpx rgba(110, 153, 127, .1); }
.support-copy { margin-top: 25rpx; color: #667067; font-size: 22rpx; line-height: 1.78; }
.support-rights { margin-top: 25rpx; padding: 24rpx; border-radius: 24rpx; background: linear-gradient(135deg, #38664e, #284e3a); color: #fff; box-shadow: 0 13rpx 28rpx rgba(40, 78, 58, .17); }
.rights-label { color: rgba(255, 255, 255, .65); font-size: 18rpx; letter-spacing: 2rpx; }
.rights-title { margin-top: 8rpx; font-size: 28rpx; font-weight: 700; }
.rights-desc { margin-top: 9rpx; color: rgba(255, 255, 255, .78); font-size: 21rpx; line-height: 1.55; }
.support-exit-note { margin-top: 24rpx; padding: 20rpx 22rpx; border-left: 5rpx solid #d6bd7c; border-radius: 4rpx 18rpx 18rpx 4rpx; background: #fbf6e9; color: #7f704e; font-size: 20rpx; line-height: 1.7; }
.support-primary { height: 80rpx; margin-top: 28rpx; border-radius: 22rpx; background: #315f48; color: #fff; font-size: 25rpx; font-weight: 650; line-height: 80rpx; box-shadow: 0 10rpx 24rpx rgba(49, 95, 72, .19); }
.support-primary:active { transform: scale(.985); background: #284f3b; }
.support-footnote { margin-top: 17rpx; color: #a0a69e; font-size: 19rpx; text-align: center; }
@keyframes support-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes support-dialog-in { from { opacity: 0; transform: translateY(36rpx) scale(.965); } to { opacity: 1; transform: translateY(0) scale(1); } }
