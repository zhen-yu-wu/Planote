.auth-shell { padding: 88rpx 44rpx 80rpx; text-align: center; }
.auth-mark { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; margin: 0 auto; border-radius: 30rpx; background: linear-gradient(145deg, #edf6ef, #d9eadf); color: #2f6b4f; font-size: 45rpx; font-weight: 750; box-shadow: 0 12rpx 30rpx rgba(47, 107, 79, .12); }
.auth-title { margin-top: 34rpx; color: #283029; font-size: 38rpx; font-weight: 750; }
.auth-desc { margin: 18rpx auto 0; max-width: 600rpx; color: #7c847b; font-size: 25rpx; line-height: 1.7; }
.key-card { margin-top: 54rpx; padding: 0 28rpx; border: 1rpx solid #e3e7e1; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(41, 53, 44, .05); }
.key-input { height: 104rpx; color: #313a32; font-size: 29rpx; text-align: left; }
.verify-button { width: 460rpx; margin: 34rpx auto 0; border-radius: 44rpx; background: #2f6b4f; color: #fff; font-size: 28rpx; font-weight: 650; line-height: 88rpx; box-shadow: 0 12rpx 28rpx rgba(47, 107, 79, .2); }
.verify-button::after { border: 0; }
.security-note { margin-top: 30rpx; color: #a0a69e; font-size: 21rpx; line-height: 1.6; }
