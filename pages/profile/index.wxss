.profile-shell { padding-top: 36rpx; }
.brand-card { display: flex; align-items: center; padding: 32rpx; }
.brand-mark { position: relative; display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; margin-right: 22rpx; overflow: hidden; border: 1rpx solid #cedfd3; border-radius: 24rpx; background: linear-gradient(145deg, #edf6ef, #dcebe1); color: #2f6b4f; font-size: 36rpx; font-weight: 700; box-shadow: 0 7rpx 18rpx rgba(47, 107, 79, .1); }
.brand-mark text { position: relative; z-index: 1; }
.mark-accent { position: absolute; top: -18rpx; right: -14rpx; width: 50rpx; height: 50rpx; border-radius: 50%; background: rgba(75, 137, 99, .14); }
.brand-name { font-size: 37rpx; font-weight: 750; letter-spacing: .5rpx; }
.brand-sub { margin-top: 6rpx; color: #8a9187; font-size: 24rpx; }
.stats-card { display: flex; margin-top: 24rpx; padding: 28rpx 6rpx; }
.stat { position: relative; display: flex; flex: 1; flex-direction: column; align-items: center; }
.stat + .stat::before { position: absolute; top: 5rpx; bottom: 5rpx; left: 0; width: 1rpx; background: #eceee9; content: ''; }
.stat-value { font-size: 38rpx; font-weight: 700; }
.stat-label { margin-top: 6rpx; color: #697164; font-size: 24rpx; }
.menu-card { overflow: hidden; }
.menu-row { display: flex; align-items: center; justify-content: space-between; min-height: 100rpx; padding: 0 24rpx; }
.menu-row + .menu-row { border-top: 1rpx solid #eff1ec; }
.menu-row > text { color: #697164; font-size: 39rpx; }
.menu-sub { margin-top: 6rpx; color: #697164; font-size: 24rpx; }
.menu-row.danger { color: #b95342; }
.sync-row { background: linear-gradient(90deg, rgba(235, 244, 237, .7), rgba(255, 255, 255, 0)); }
.sync-row switch { transform: scale(.84); transform-origin: right center; }
.cloud-status { padding: 7rpx 13rpx; border-radius: 999rpx; background: #eff1ed; color: #80877e; font-size: 24rpx; }
.cloud-status.checking { background: #fff2df; color: #697164; }
.cloud-status.connected { background: #e5f1e8; color: #347152; }
.cloud-status.failed { background: #ffebe6; color: #b64f3c; }
.cloud-status.locked { background: #f1eeea; color: #8b7d70; }
.access-row { background: linear-gradient(90deg, rgba(246, 241, 231, .72), rgba(255, 255, 255, 0)); }
.local-note { margin-top: 48rpx; color: #697164; text-align: center; font-size: 24rpx; }
.support-entry { display: flex; align-items: center; min-height: 112rpx; padding: 16rpx 24rpx; box-sizing: border-box; }
.support-entry:active { background: #f8faf7; }
.support-entry-copy { min-width: 0; flex: 1; }
.support-entry-title { color: #30392f; font-size: 28rpx; }
.support-entry-sub { margin-top: 8rpx; color: #858c81; font-size: 24rpx; line-height: 1.5; }
.support-entry-arrow { flex: 0 0 auto; margin-left: 20rpx; color: #697164; font-size: 39rpx; }
.support-overlay { position: fixed; z-index: 100; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 32rpx; background: rgba(25, 32, 27, .42); }
.support-dialog { box-sizing: border-box; width: 100%; max-width: 680rpx; overflow: hidden; border-radius: 24rpx; background: #fffefa; }
.support-header { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 24rpx 22rpx 32rpx; border-bottom: 1rpx solid #eeeee7; }
.support-dialog-title { color: #30392f; font-size: 32rpx; font-weight: 600; }
.support-close { flex: 0 0 auto; width: 64rpx; height: 64rpx; margin: 0 0 0 16rpx; padding: 0; background: transparent; color: #858c81; font-size: 38rpx; line-height: 64rpx; }
.support-close::after, .support-primary::after { border: 0; }
.support-scroll { height: 54vh; max-height: 660rpx; }
.support-letter { padding: 28rpx 32rpx 32rpx; color: #50574d; font-size: 26rpx; line-height: 1.85; overflow-wrap: break-word; }
.support-paragraph + .support-paragraph { margin-top: 24rpx; }
.support-thanks { margin-top: 32rpx; }
.support-signature { margin-top: 12rpx; color: #83897e; font-size: 24rpx; text-align: right; }
.support-contact { margin-top: 32rpx; padding-top: 26rpx; border-top: 1rpx solid #eeeee7; }
.support-contact-title { color: #30392f; font-size: 27rpx; font-weight: 500; }
.support-contact-copy { margin-top: 12rpx; font-size: 24rpx; line-height: 1.8; }
.support-qr { display: block; width: 420rpx; max-width: 100%; height: auto; margin: 22rpx auto 0; background: #fff; }
.support-qr-hint { margin-top: 14rpx; color: #83897e; font-size: 24rpx; line-height: 1.6; text-align: center; }
.support-footer { padding: 20rpx 32rpx 24rpx; border-top: 1rpx solid #eeeee7; }
.support-primary { margin: 0; padding: 0 16rpx; border-radius: 12rpx; background: #edf2eb; color: #35563e; font-size: 26rpx; font-weight: 400; line-height: 80rpx; }
.support-primary:active { background: #e2eade; }
.support-footnote { margin-top: 14rpx; color: #858c81; font-size: 24rpx; line-height: 1.5; text-align: center; }
